# 推荐在应用「设置 → 大模型」中配置并即时生效。
# 以下仅为尚未在界面保存时使用的启动默认值。
# 复制为 backend/.env 并填入真实值（.env 已被 git 忽略，不会提交）

# AI 面试：LLM（OpenAI 兼容接口，默认 DeepSeek，可换任意兼容服务）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-你的key

# 接口格式：chat_completions 或 responses（OpenAI 新接口）
LLM_API_STYLE=chat_completions

# 可选：采样温度
# LLM_TEMPERATURE=0.7

# 可选：TTS 音色（默认男声，女声改 zh-CN-XiaoxiaoNeural）
# TTS_VOICE=zh-CN-YunxiNeural
